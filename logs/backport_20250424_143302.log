diff --git a/src/string.c b/src/string.c
new file mode 100644
--- /dev/null
+++ b/src/string.c
@@ -0,0 +1,197 @@
+#include "string.h"
+
+/* Glob-style pattern matching. */
+static int stringmatchlen_impl(const char *pattern, int patternLen,
+        const char *string, int stringLen, int nocase, int *skipLongerMatches, int nesting)
+{
+    /* Protection against abusive patterns. */
+    if (nesting > 1000) return 0;
+
+    while(patternLen && stringLen) {
+        switch(pattern[0]) {
+        case '*':
+            if (patternLen == 1) {
+                return 1; /* match */
+            }
+            while(stringLen) {
+                if (stringmatchlen_impl(pattern+1, patternLen-1,
+                            string, stringLen, nocase, skipLongerMatches, nesting+1))
+                    return 1; /* match */
+                if (*skipLongerMatches)
+                    return 0; /* no match */
+                stringLen--; string++;
+            }
+            return 0;
+        case '?':
+            stringLen--; string++;
+            patternLen--; pattern++;
+            break;
+        case '\\':
+            patternLen--; pattern++;
+            /* fallthrough */
+        default:
+            if (nocase) {
+                char p = toupper(pattern[0]);
+                char s = toupper(string[0]);
+                if (p != s) return 0;
+            } else {
+                if (pattern[0] != string[0]) return 0;
+            }
+            stringLen--; string++;
+            patternLen--; pattern++;
+            break;
+        }
+    }
+
+    if (patternLen == 0) return stringLen == 0;
+    return 0; /* no match */
+}
+
+int stringmatchlen(const char *pattern, int patternLen,
+        const char *string, int stringLen, int nocase) {
+    int skipLongerMatches = 0;
+    return stringmatchlen_impl(pattern,patternLen,string,stringLen,nocase,&skipLongerMatches,0);
+}
+
+int stringmatch(const char *pattern, const char *string, int nocase) {
+    if (pattern == NULL || string == NULL) return 0;
+    return stringmatchlen(pattern,strlen(pattern),string,strlen(string),nocase);
+}
+
+/* Additional utility functions for pattern matching */
+/* ... remaining code from util.c copied and adapted here ... */
+
