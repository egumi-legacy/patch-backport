# API服务环境变量示例文件
# 复制为 .env 文件并填入适当的值

# OpenAI API配置
OPENAI_API_KEY=your_api_key_here
OPENAI_BASE_URL=your_api_base_url_here

# GitHub访问令牌（用于API访问）
GITHUB_TOKEN=your_github_token_here

# 服务配置
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8000
LOG_LEVEL=info

# 数据库配置
DATABASE_PATH=data/cve_database.db

# 缓存配置
USE_CACHED_PATCHES=true
CACHE_DIR=cache

# 任务管理
MAX_CONCURRENT_TASKS=3
TASK_TIMEOUT=3600 