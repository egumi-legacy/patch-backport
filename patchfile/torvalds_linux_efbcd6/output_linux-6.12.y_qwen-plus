 -		return true;
 +static inline int flag_is_changeable_p(u32 flag)
 +{
 +	u32 f1, f2;
  
 -bool have_cpuid_p(void)
 +int have_cpuid_p(void)
  {
  	return flag_is_changeable_p(X86_EFLAGS_ID);
  }
@@ -352,6 +349,10 @@
