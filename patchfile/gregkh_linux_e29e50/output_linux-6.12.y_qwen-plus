A. Commit message:
ALSA: ump: Indicate the inactive group in legacy substream names for older version

B. Change summary:
This patch backports the functionality to indicate inactive UMP groups in legacy rawmidi substream names with a "[Inactive]" suffix when the corresponding UMP group is inactive. Additionally, it ensures proper validation of block indices and correct formatting for group names.

C. Compatibility Risk:
Medium

D. Fixed Code:
```diff
diff --git a/sound/core/ump.c b/sound/core/ump.c
index 9f9ad106107f7..7b00a957e5489 100644
--- a/sound/core/ump.c
+++ b/sound/core/ump.c
@@ -366,7 +366,7 @@ static int snd_ump_block_new(struct snd_ump *ump, unsigned int blk,
  {
  	struct snd_ump_block *fb, *p;
  
-	if (blk >= SNDRV_UMP_MAX_BLOCKS)
+	if (blk < 0 || blk >= SNDRV_UMP_MAX_BLOCKS)
  		return -EINVAL;
  
  	if (snd_ump_get_block(ump, blk))
@@ -387,7 +387,7 @@ static int snd_ump_block_new(struct snd_ump *ump, unsigned int blk,
  	fb->info.first_group = first_group;
  	fb->info.num_groups = num_groups;
-	snprintf(fb->info.name, sizeof(fb->info.name), "Group %u-%u",
+	snprintf(fb->info.name, sizeof(fb->info.name), "Group %d-%d",
  		 first_group + 1, first_group + num_groups);
  
@@ -1087,8 +1087,6 @@ static int snd_ump_legacy_open(struct snd_ump *ump, int dir, int group,
  	guard(mutex)(&ump->open_mutex);
  	if (ump->legacy_substreams[dir][group])
  		return -EBUSY;
-	if (!ump->groups[group].active)
-		return -ENODEV;
  	if (dir == SNDRV_RAWMIDI_STREAM_OUTPUT) {
  		if (!ump->legacy_out_opens) {
  			err = snd_rawmidi_kernel_open(&ump->core, 0,
@@ -1256,8 +1254,9 @@ static void fill_substream_names(struct snd_ump_endpoint *ump,
 		name = ump->groups[idx].name;
 		if (!*name)
 			name = ump->info.name;
-		snprintf(s->name, sizeof(s->name), "Group %d (%.16s)",
-			 idx + 1, name);
+		snprintf(s->name, sizeof(s->name), "Group %d (%.16s)%s",
+			 idx + 1, name,
+			 ump->groups[idx].active ? "" : " [Inactive]");
 	}
 }
```