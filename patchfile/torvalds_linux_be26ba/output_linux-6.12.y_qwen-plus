 	if (!q->mq_sysfs_init_done)
-		goto unlock;
+		return;

 	queue_for_each_hw_ctx(q, hctx, i)
 		blk_mq_unregister_hctx(hctx);

-unlock:
-	mutex_unlock(&q->sysfs_dir_lock);
 }

