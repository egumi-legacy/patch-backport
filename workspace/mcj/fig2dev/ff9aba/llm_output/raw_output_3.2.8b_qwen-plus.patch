index 387527b..f643f7e 100644
--- a/fig2dev/read.c
+++ b/fig2dev/read.c
@@ -1159,6 +1159,14 @@ sanitize_lineobject(
 						l->type - 2,
 						line_no);
 				return -1;
+			}
