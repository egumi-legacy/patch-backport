 int ufshcd_alloc_host(struct device *dev, struct ufs_hba **hba_handle)
 {
 	struct Scsi_Host *host;
 	struct ufs_hba *hba;
 	int err = 0;
 
 	if (!dev) {
 		dev_err(dev,
 		"Invalid memory reference for dev is NULL\n");
 		err = -ENODEV;
 		goto out_error;
