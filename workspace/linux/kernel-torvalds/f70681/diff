 +	struct offset_ctx *octx;
 +	struct dentry *child;
 +	unsigned long index;
 +	int ret = 1;
 +
 +	if (!inode || !S_ISDIR(inode->i_mode))
 +		return ret;
 +
 +	index = DIR_OFFSET_MIN;
 +	octx = inode->i_op->get_offset_ctx(inode);
